CI_ENVIRONMENT = production
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''

database.default.hostname = localhost
database.default.database = smt_analysis
database.default.username = your_mysql_user
database.default.password = 'your_mysql_password'
database.default.DBDriver = MySQLi
database.default.DBPrefix = ''
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_bin
database.default.DBDebug = false

# Enable when deploying with HTTPS:
# app.forceGlobalSecureRequests = true
# cookie.secure = true

email.protocol = smtp
email.SMTPHost = smtp.gmail.com
email.SMTPPort = 587
email.SMTPCrypto = tls
email.fromName = 'Summit Analytics'
# Gmail sender credentials: use a Google app password, not your normal password.
# email.SMTPUser = your-address@gmail.com
# email.SMTPPass = 'your-google-app-password'
# email.fromEmail = your-address@gmail.com
